# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/license_key_db

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3001

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
